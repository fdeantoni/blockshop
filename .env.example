# Copy to .env for running Blockshop from the checkout (pnpm dev:server, pnpm start). The family server runs the image: deploy/docker-compose.yml.
PORT=8080
# Public base URL exactly as the iPads reach the server (used in pack links).
HOST_URL=http://my-computer.local:8080
DATA_DIR=./data
# Run Minecraft Creator Tools validation on every publish (main suite).
VALIDATE=true
MCT_SUITE=main
UI_TITLE=Blockshop
LOG_LEVEL=info

# Replaces a forgotten grown-up PIN at the next start (4-8 digits); remove it again afterwards.
#ADMIN_PIN=

# Family server export (docs/family-server-internals.md). off | on (the grown-up page updates the server; kids' publishes never do)
JAVA_DEPLOY=off
#CRAFTENGINE_DIR=/srv/paper/plugins/CraftEngine
#GEYSER_DIR=/srv/paper/plugins/Geyser-Spigot
#PLUGINS_DIR=/srv/paper/plugins
#RCON_HOST=127.0.0.1
#RCON_PORT=25575
#RCON_PASSWORD=
#RCON_TIMEOUT_MS=120000
#JAVA_RCON_COMMANDS=ce reload all; geyser reload
#JAVA_RESTART_COMMAND=docker restart mc
#JAVA_RESTART_WAIT_MS=180000
#MC_LOG_FILE=/srv/paper/logs/latest.log

# Development stack (docker-compose.yml): compose reads this file for ${...} substitution.
# The address a tablet uses to reach this computer; defaults to http://localhost:8081.
#BLOCKSHOP_HOST_URL=http://my-computer.local:8081
#BLOCKSHOP_PORT=8081
#BLOCKSHOP_JAVA_DEPLOY=on
#BLOCKSHOP_RESTART_COMMAND=          # empty: restart the server by hand (default: docker restart mc)
#RCON_PASSWORD=blockshop-dev
