<?xml version="1.0" encoding="UTF-8"?>
<!--
  BlockshopCatalog: a tiny Paper plugin that gives Bedrock players a native menu (Floodgate form) to
  pick furniture from, and opens CraftEngine's item browser for Java players. Built inside the
  Blockshop Docker image (Dockerfile); Blockshop copies the jar and pieces.json into
  the server's plugins folder on deploy. See docs/family-server-internals.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>family.blockshop</groupId>
  <artifactId>BlockshopCatalog</artifactId>
  <version>0.5.1</version>
  <packaging>jar</packaging>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0 or later</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible jar: identical sources give identical bytes, so a new Blockshop image only makes the family
         server restart for the plugin when the plugin itself changed. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>opencollab-snapshot</id>
      <url>https://repo.opencollab.dev/main/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.2.build.123-stable</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.geysermc.floodgate</groupId>
      <artifactId>api</artifactId>
      <version>2.2.5-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>BlockshopCatalog</finalName>
  </build>
</project>
